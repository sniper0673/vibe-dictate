{
  "manifest_version": 3,
  "name": "Vibe Dictate Browser Bridge",
  "version": "0.1.0",
  "description": "Routes Vibe Dictate transcriptions into the active browser tab without switching tabs.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content-script.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Vibe Dictate Browser Bridge"
  }
}
